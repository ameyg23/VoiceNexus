{
  "name": "voice-nexus",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:migrate": "npm run migrate --workspace=packages/db",
    "db:seed": "npm run seed --workspace=packages/db",
    "server:dev": "npm run dev --workspace=apps/server",
    "dev": "concurrently -n server,web -c blue,green \"npm run server:dev\" \"npm run dev --workspace=apps/web\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  }
}
