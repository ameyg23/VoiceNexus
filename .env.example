# --- AI ---
GEMINI_API_KEY=

# --- Email OTP (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Employee auth ---
JWT_SECRET=

# --- Server ---
PORT=4000
DEMO_MODE=true
WEB_ORIGIN=http://localhost:3000

# --- Real telephony (wired last, only used for Sunday's live test) ---
# Trial accounts get exactly 1 Twilio number, so there's no second Twilio number here.
# The test "caller" is a browser-mic call via Twilio Voice SDK (see CLAUDE.md), not a phone.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CARE_LINE_NUMBER=
# Public https URL Twilio calls (ngrok during dev). Twilio signs webhooks over this exact URL.
PUBLIC_BASE_URL=
# Voice JS SDK (browser test-call page). Created by `npm run twilio:setup --workspace=apps/server -- <PUBLIC_BASE_URL>`.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
